{
  "extends": "./tsconfig.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "tests/**"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
