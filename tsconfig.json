// tsconfig.json
{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.vitest.json"
    }
  ],
  "compilerOptions": {
    // ★ Array.prototype.at の型を含む
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // Vite/TSの相性が良い解決方法
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // ここは型解決まわり（現状のままでOK）
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // パスエイリアス
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
    // （任意）厳格化やビルド速度
    // "strict": true,
    // "skipLibCheck": true
  }
}
